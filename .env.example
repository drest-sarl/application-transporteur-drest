# ===== À saisir dans Vercel → Project → Settings → Environment Variables (jamais dans le code) =====
# Base Neon : ajoutée automatiquement par Vercel quand on relie la base (DATABASE_URL ou POSTGRES_URL)
DATABASE_URL=

# Accès à l'écran d'administration (mot de passe choisi par vous)
ADMIN_PASSWORD=
# Clé secrète des appels automatiques (cron-job.org) : une longue chaîne au hasard
CRON_SECRET=

# Back-office Drest — compte de service (droit : lire les commandes + forcer un statut)
BO_URL=https://bo.drest.tn
BO_LOGIN=
BO_PASSWORD=

# Big Boss Express
BIGBOSS_UTILISATEUR=
BIGBOSS_PASS=
BIGBOSS_WEBHOOK_SECRET=

# AFEX
AFEX_API_KEY=

# Aramex
ARAMEX_USERNAME=
ARAMEX_PASSWORD=
ARAMEX_ACCOUNT_NUMBER=72655188
ARAMEX_ACCOUNT_PIN=
ARAMEX_ACCOUNT_ENTITY=TUN
ARAMEX_COUNTRY_CODE=TN

# Drest Delivery (API Supabase, lecture seule de la table colis)
DD_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
DD_SUPABASE_KEY=

# Réglages (facultatifs)
LIMITE_PAR_HEURE=700
JOURS_SUIVI=45
# suivi des colis chez les transporteurs (et 1re lecture Drest Delivery) : 6 mois
JOURS_COLIS=180
